# ─────────────────────────────────────────────────────────────
# ATLAS — configuración del cerebro central (servidor)
# Copia este archivo como ".env" (o ejecuta: npm run setup)
# NUNCA subas el archivo .env a GitHub: contiene secretos.
# ─────────────────────────────────────────────────────────────

# Clave de API de Anthropic (Claude). Consíguela en https://console.anthropic.com/settings/keys
# Si la dejas vacía, ATLAS funciona en "modo demostración" (sin IA real).
ANTHROPIC_API_KEY=

# Modelo por defecto (se puede cambiar luego desde Configuración).
ATLAS_DEFAULT_MODEL=claude-opus-5-5

# Puerto y dirección de escucha. 127.0.0.1 = sólo accesible desde este computador
# (recomendado; para el iPhone usa Tailscale, ver docs/IPHONE.md).
PORT=8787
HOST=127.0.0.1

# Carpeta donde se guarda la base de datos (memoria, conversaciones, etc.).
ATLAS_DATA_DIR=./data

# Código de configuración inicial (opcional). Si lo dejas vacío, el servidor
# genera uno aleatorio y lo muestra en la consola la primera vez.
ATLAS_SETUP_CODE=
